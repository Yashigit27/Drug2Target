# Copy to .env and fill in values you need:
#   copy .env.example .env

# Optional: override Open Targets GraphQL URL (default is public Platform API)
# OPENTARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql

# Set to 0/false/no to disable Europe PMC + TF-IDF literature branch in step 2
LITERATURE_RAG_ENABLED=true

# Optional TLS overrides (usually not needed — container uses ca-certificates)
# SSL_CERT_FILE=/path/to/custom-ca-bundle.pem
# HTTPX_SSL_VERIFY=false

# Optional: LLM gene narratives on Results (leave empty to use template text)
# OPENAI_API_KEY=sk-...

# Optional: create an admin user on first startup (Docker / fresh server)
# D2T_BOOTSTRAP_EMAIL=admin@example.com
# D2T_BOOTSTRAP_PASSWORD=change-me-to-a-long-password
